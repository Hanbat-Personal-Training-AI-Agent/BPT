+    func testHalpeOwnMappingReplacesPelvisThoraxHead() throws {
+        let coco = (0..<17).map { PoseKeypoint(x: 300 + Double($0) * 5, y: 200 + Double($0) * 50, confidence: 0.9) }
+        var extra = (17..<26).map { PoseKeypoint(x: Double($0), y: Double($0) * 2, confidence: 0.5) }
+        extra[Halpe26.hip - 17] = PoseKeypoint(x: 330, y: 760, confidence: 0.8)
+        extra[Halpe26.neck - 17] = PoseKeypoint(x: 320, y: 420, confidence: 0.6)
+        extra[Halpe26.head - 17] = PoseKeypoint(x: 302, y: 150, confidence: 0.7)
+        let app = try PoseCoordinateTransforms.coco17ToH36M17(coco)
+        let own = try PoseCoordinateTransforms.halpe26ToH36M17(coco17: coco, extra: extra)
+        XCTAssertEqual(own[0].y, 760); XCTAssertEqual(own[8].y, 420); XCTAssertEqual(own[10].x, 302)
+        XCTAssertEqual(own[7].y, 590, accuracy: 1e-9)  // mid(pelvis, thorax)
+        XCTAssertEqual(own[9].y, (200 + 420) / 2, accuracy: 1e-9)  // mid(nose, thorax)
+        XCTAssertEqual(own[7].confidence, 0.7, accuracy: 1e-9)
+        for j in [1, 2, 3, 4, 5, 6, 11, 12, 13, 14, 15, 16] { XCTAssertEqual(own[j].x, app[j].x) }
+        XCTAssertThrowsError(try PoseCoordinateTransforms.halpe26ToH36M17(coco17: coco, extra: []))
+    }
