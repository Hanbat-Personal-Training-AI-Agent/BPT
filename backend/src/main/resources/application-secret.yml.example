# 실제 비밀값을 작성하는 파일 예시입니다.
# 이 파일을 복사하여 같은 폴더에 'application-secret.yml'로 저장하시면 됩니다.
# (.gitignore에 등록되어 있으므로 application-secret.yml은 Git에 올라가지 않습니다)
# 운영 서버에서는 이 파일 대신 환경변수(DB_PASSWORD, JWT_SECRET, MAIL_USERNAME, MAIL_PASSWORD)를 써도 됩니다.
spring:
  datasource:
    password: your_db_password
  mail:
    username: your_email@gmail.com
    password: your_16_digit_app_password

jwt:
  # openssl rand -base64 48 로 만든 값. 운영 서버와 Modal(bpt-jwt)은 같은 값을 써야 합니다.
  secret: your_base64_jwt_secret
